# ── OpenRouter (LLM_PROVIDER=openrouter) ──────────────────────────────────────
# API key gratuita en https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── LiteLLM Gateway ──────────────────────────────────────
LITELLM_MASTER_KEY=sk-...
DATABASE_URL=postgresql://litellm:litellm@litellm-db:5432/litellm
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MODEL_NAME=model_name_here
OPENROUTER_MODEL=openrouter/model_name_here:free

# ── LangFuse self-hosted ──────────────────────────────────
# Estas las defines tú — son las keys que usará tu instancia local
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000

# Para el bootstrap automático de LangFuse
LANGFUSE_NEXTAUTH_SECRET=your_nextauth_secret_here
LANGFUSE_SALT=your_salt_here
# IMPORTANTE: debe ser exactamente 64 caracteres hexadecimales
LANGFUSE_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here


LANGFUSE_INIT_USER_EMAIL=your_admin_email_here
LANGFUSE_INIT_USER_NAME=your_admin_name_here
LANGFUSE_INIT_USER_PASSWORD=your_admin_password_here

# ── ClickHouse ────────────────────────────────────────────
CLICKHOUSE_PASSWORD=your_clickhouse_password_here

# ── MinIO ─────────────────────────────────────────────────
MINIO_ROOT_USER=your_minio_root_user_here
MINIO_ROOT_PASSWORD=your_minio_root_password_here

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password_here

# ── App ───────────────────────────────────────────────────
APP_VERSION=1.0.0
APP_ENV=development